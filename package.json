  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
